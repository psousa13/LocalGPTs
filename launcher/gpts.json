[
  {
    "name": "LocalGPT",
    "description": "RAG-only contract assistant (LocalGPT + Ollama)",
    "health_url": "http://127.0.0.1:8001/health",
    "open_url": "http://localhost:3000",
    "timeout": 300,
    "linux": {
      "cwd": "localgpt",
      "venv_bin": "localgpt/.venv-linux/bin",
      "path": [
        "bin-linux",
        "node-linux/bin"
      ],
      "env": {
        "CUDA_VISIBLE_DEVICES": ""
      },
      "services": [
        {
          "name": "ollama",
          "cmd": [
            "ollama",
            "serve"
          ],
          "env": {
            "OLLAMA_MAX_LOADED_MODELS": "1",
            "OLLAMA_CONTEXT_LENGTH": "4096"
          },
          "mem": "3G",
          "wait_port": 11434
        },
        {
          "name": "localgpt",
          "cmd": [
            "python",
            "run_system.py"
          ],
          "mem": "9G"
        }
      ]
    },
    "windows": {
      "cwd": "localgpt",
      "venv_bin": "localgpt/.venv/Scripts",
      "path": [
        "bin",
        "node",
        "ollama"
      ],
      "env": {},
      "timeout": 600,
      "services": [
        {
          "name": "ollama",
          "cmd": [
            "ollama",
            "serve"
          ],
          "env": {
            "OLLAMA_MAX_LOADED_MODELS": "1",
            "OLLAMA_CONTEXT_LENGTH": "4096"
          },
          "wait_port": 11434
        },
        {
          "name": "localgpt",
          "cmd": [
            "python",
            "run_system.py"
          ]
        }
      ]
    }
  },
  {
    "name": "Open WebUI",
    "description": "RAG-only chat (Open WebUI + Ollama).",
    "health_url": "http://127.0.0.1:8080/health",
    "health_match": "status",
    "open_url": "http://127.0.0.1:8080",
    "timeout": 300,
    "linux": {
      "cwd": "open-webui",
      "venv_bin": "open-webui/.venv-linux/bin",
      "path": [
        "bin-linux"
      ],
      "env": {
        "CUDA_VISIBLE_DEVICES": "",
        "ENABLE_OPENAI_API": "false",
        "ENABLE_WEB_SEARCH": "false",
        "ENABLE_PERSISTENT_CONFIG": "False",
        "ENABLE_RAG_HYBRID_SEARCH": "false",
        "RAG_TOP_K": "3",
        "RAGONLY_MIN_SCORE": "0",
        "SCARF_NO_ANALYTICS": "true",
        "DO_NOT_TRACK": "true",
        "ANONYMIZED_TELEMETRY": "false"
      },
      "services": [
        {
          "name": "ollama",
          "cmd": [
            "ollama",
            "serve"
          ],
          "env": {
            "OLLAMA_MAX_LOADED_MODELS": "1",
            "OLLAMA_CONTEXT_LENGTH": "4096"
          },
          "mem": "3G",
          "wait_port": 11434
        },
        {
          "name": "open-webui",
          "cmd": [
            "open-webui",
            "serve",
            "--host",
            "127.0.0.1",
            "--port",
            "8080"
          ],
          "mem": "6G"
        }
      ]
    }
  },
  {
    "name": "PrivateGPT",
    "description": "RAG chat (PrivateGPT + Ollama), web search removed.",
    "health_url": "http://127.0.0.1:8002/health",
    "open_url": "http://127.0.0.1:8002/ui",
    "timeout": 300,
    "linux": {
      "cwd": "data-privategpt",
      "venv_bin": "private-gpt/.venv-linux/bin",
      "path": [
        "bin-linux"
      ],
      "env": {
        "OPENAI_API_BASE": "http://127.0.0.1:11434/v1",
        "OPENAI_EMBEDDING_API_BASE": "http://127.0.0.1:11434/v1",
        "PGPT_OFFLINE_MODE": "true",
        "PGPT_RETRIEVAL_TOP_K": "4",
        "PGPT_WEBSEARCH_ENABLED": "false",
        "PGPT_LOCAL_DATA_FOLDER": "$ROOT/data-privategpt/local_data",
        "PGPT_QDRANT_PATH": "$ROOT/data-privategpt/qdrant",
        "DO_NOT_TRACK": "true",
        "PGPT_LLM_DEFAULT": "qwen3.5:4b"
      },
      "services": [
        {
          "name": "ollama",
          "cmd": [
            "ollama",
            "serve"
          ],
          "env": {
            "OLLAMA_MAX_LOADED_MODELS": "1",
            "OLLAMA_CONTEXT_LENGTH": "4096"
          },
          "mem": "3G",
          "wait_port": 11434,
          "wait_models": [
            "qwen3.5:2b",
            "qwen3.5:4b",
            "mxbai-embed-large:latest"
          ]
        },
        {
          "name": "private-gpt",
          "cmd": [
            "private-gpt",
            "serve",
            "--host",
            "127.0.0.1",
            "--port",
            "8002"
          ]
        }
      ]
    }
  }
]
